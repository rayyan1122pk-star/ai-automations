    "OpenAI": { "ai_languageModel": [[{ "node": "AI Agent: Summarize Change", "type": "ai_languageModel", "index": 0 }]] },
    "Structured Output": { "ai_outputParser": [[{ "node": "AI Agent: Summarize Change", "type": "ai_outputParser", "index": 0 }]] },
    "AI Agent: Summarize Change": { "main": [[{ "node": "Append Changelog", "type": "main", "index": 0 }]] },
