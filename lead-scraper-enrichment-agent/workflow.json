    {
      "parameters": {
        "jsCode": "const r = $json;\nconst hasWebsite = !!r.website;\nconst rating = r.rating || 0;\nconst reviewCount = r.user_ratings_total || 0;\nlet score = 0;\nif (!hasWebsite) score += 40; // strong opportunity - no site yet\nif (rating < 4.0 && reviewCount > 10) score += 20; // reputation opportunity\nif (reviewCount > 50) score += 20; // established business, budget likely\nif (rating >= 4.5) score += 10;\nreturn [{ json: { name: r.name, address: r.formatted_address, rating, review_count: reviewCount, has_website: hasWebsite, place_id: r.place_id, score } }];"
      },
      "id": "ls-score-01",
      "name": "Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [140, 0]
    },
