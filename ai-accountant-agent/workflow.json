{
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] } }, "id": "acc-trigger-01", "name": "Every 6 Hours", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-560, 0] },
    { "parameters": { "operation": "getAll", "filters": { "q": "label:invoices is:unread" } }, "id": "acc-getinv-01", "name": "Get Invoice Emails", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [-320, 0] },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": { "systemMessage": "Extract structured invoice/expense data from this email: vendor, amount, currency, date, and a best-guess expense category (e.g. Software, Marketing, Utilities, Contractors)." }
      },
      "id": "acc-agent-01",
      "name": "Extract Invoice Data",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-80, 0]
    },
    { "parameters": { "model": "gpt-4o-mini" }, "id": "acc-model-01", "name": "OpenAI", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "typeVersion": 1, "position": [-120, 160] },
    { "parameters": { "schemaType": "manual", "inputSchema": "{\"type\":\"object\",\"properties\":{\"vendor\":{\"type\":\"string\"},\"amount\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\"},\"date\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"}}}" }, "id": "acc-parser-01", "name": "Structured Output", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "typeVersion": 1.2, "position": [0, 160] },
    { "parameters": { "operation": "append", "sheetName": { "value": "Ledger", "mode": "list" }, "columns": { "mappingMode": "autoMapInputData" } }, "id": "acc-log-01", "name": "Append to Ledger", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [140, 0] },
    { "parameters": { "conditions": { "conditions": [{ "leftValue": "={{ $json.output.amount }}", "rightValue": 500, "operator": { "type": "number", "operation": "gt" } }] } }, "id": "acc-if-01", "name": "If Amount > $500", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [360, 0] },
    { "parameters": { "channel": "finance-alerts", "text": "=Large expense logged: {{ $json.output.vendor }} — {{ $json.output.currency }} {{ $json.output.amount }} ({{ $json.output.category }})" }, "id": "acc-slack-01", "name": "Notify Large Expense", "type": "n8n-nodes-base.slack", "typeVersion": 2.3, "position": [580, -60] },
    { "parameters": { "operation": "addLabels", "messageId": "={{ $('Get Invoice Emails').item.json.id }}", "labelIds": ["Processed"] }, "id": "acc-label-01", "name": "Mark Email Processed", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [580, 60] },
    { "parameters": { "rule": { "interval": [{ "triggerAtDayOfMonth": 1 }] } }, "id": "acc-monthly-01", "name": "Monthly on the 1st", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-560, 220] },
    { "parameters": { "operation": "read", "sheetName": { "value": "Ledger", "mode": "list" } }, "id": "acc-readledger-01", "name": "Read Ledger", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [-320, 220] },
    { "parameters": { "jsCode": "const rows = $input.all().map(i => i.json);\nconst byCategory = {};\nlet total = 0;\nfor (const r of rows) {\n  const amt = Number(r.amount) || 0;\n  total += amt;\n  byCategory[r.category] = (byCategory[r.category] || 0) + amt;\n}\nreturn [{ json: { total_expenses: total, by_category: byCategory, month: new Date().toISOString().slice(0,7) } }];" }, "id": "acc-summary-01", "name": "Compute Summary", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-80, 220] },
    { "parameters": { "sendTo": "you@example.com", "subject": "=Monthly Expense Summary — {{ $json.month }}", "message": "=Total expenses: {{ $json.total_expenses }}\\n\\nBy category:\\n{{ JSON.stringify($json.by_category, null, 2) }}" }, "id": "acc-email-01", "name": "Send Monthly Summary", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [140, 220] }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Get Invoice Emails", "type": "main", "index": 0 }]] },
    "Get Invoice Emails": { "main": [[{ "node": "Extract Invoice Data", "type": "main", "index": 0 }]] },
    "Extract Invoice Data": { "main": [[{ "node": "Append to Ledger", "type": "main", "index": 0 }]] },
    "OpenAI": { "ai_languageModel": [[{ "node": "Extract Invoice Data", "type": "ai_languageModel", "index": 0 }]] },
    "Structured Output": { "ai_outputParser": [[{ "node": "Extract Invoice Data", "type": "ai_outputParser", "index": 0 }]] },
    "Append to Ledger": { "main": [[{ "node": "If Amount > $500", "type": "main", "index": 0 }, { "node": "Mark Email Processed", "type": "main", "index": 0 }]] },
    "If Amount > $500": { "main": [[{ "node": "Notify Large Expense", "type": "main", "index": 0 }], []] },
    "Monthly on the 1st": { "main": [[{ "node": "Read Ledger", "type": "main", "index": 0 }]] },
    "Read Ledger": { "main": [[{ "node": "Compute Summary", "type": "main", "index": 0 }]] },
    "Compute Summary": { "main": [[{ "node": "Send Monthly Summary", "type": "main", "index": 0 }]] }
