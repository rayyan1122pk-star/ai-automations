{
  "nodes": [
    { "parameters": { "updates": ["messages"] }, "id": "wo-trigger-01", "name": "WhatsApp Trigger", "type": "n8n-nodes-base.whatsAppTrigger", "typeVersion": 1, "position": [-640, 0] },
    { "parameters": { "documentId": { "value": "={{ $env.CATALOG_SHEET_ID }}", "mode": "id" }, "sheetName": { "value": "catalog", "mode": "list" }, "options": {} }, "id": "wo-catalog-01", "name": "Get Catalog", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [-420, 0] },
    {
      "parameters": {
        "promptType": "define",
