{
  "nodes": [
    {
      "parameters": { "path": "vapi-call", "responseMode": "responseNode" },
      "id": "vapi-webhook-01",
      "name": "Vapi Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            { "outputKey": "FunctionCall_Booking", "conditions": { "conditions": [{ "leftValue": "={{ $json.body.message.type }}", "rightValue": "function-call", "operator": { "type": "string", "operation": "equals" } }] } },
            { "outputKey": "EndOfCall_Report", "conditions": { "conditions": [{ "leftValue": "={{ $json.body.message.type }}", "rightValue": "end-of-call-report", "operator": { "type": "string", "operation": "equals" } }] } }
          ]
        }
      },
      "id": "vapi-route-01",
      "name": "Route Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "caller_name", "value": "={{ $json.body.message.functionCall.parameters.name }}" },
            { "name": "requested_time", "value": "={{ $json.body.message.functionCall.parameters.time }}" },
            { "name": "phone", "value": "={{ $json.body.call.customer.number }}" }
          ]
        }
      },
      "id": "vapi-extract-01",
      "name": "Extract Booking Params",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-80, -100]
    },
    {
      "parameters": { "operation": "getAll", "calendar": { "value": "primary", "mode": "list" }, "timeMin": "={{ $json.requested_time }}" },
      "id": "vapi-calcheck-01",
      "name": "Check Calendar Availability",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [140, -100]
    },
    {
      "parameters": { "conditions": { "conditions": [{ "leftValue": "={{ $json.length }}", "rightValue": 0, "operator": { "type": "number", "operation": "equals" } }] } },
      "id": "vapi-ifslot-01",
      "name": "If Slot Free",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [360, -100]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": { "value": "primary", "mode": "list" },
        "start": "={{ $('Extract Booking Params').item.json.requested_time }}",
        "summary": "={{ 'Call booking - ' + $('Extract Booking Params').item.json.caller_name }}"
      },
      "id": "vapi-create-01",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [580, -180]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { result: 'Slot booked successfully' } }}" },
      "id": "vapi-respbooked-01",
      "name": "Respond: Slot Booked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [800, -180]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { result: 'That slot is taken, please offer another time' } }}" },
      "id": "vapi-resptaken-01",
      "name": "Respond: Slot Taken",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [580, -20]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": { "value": "Calls", "mode": "list" },
        "columns": { "mappingMode": "autoMapInputData" }
      },
      "id": "vapi-log-01",
      "name": "Log Call to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-80, 120]
    },
    {
      "parameters": { "conditions": { "conditions": [{ "leftValue": "={{ $json.body.message.analysis.successEvaluation }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }] } },
      "id": "vapi-ifqual-01",
      "name": "If Qualified Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [140, 120]
    },
    {
      "parameters": { "channel": "sales-leads", "text": "=New qualified lead from a call: {{ $json.body.call.customer.number }}" },
      "id": "vapi-slack-01",
      "name": "Notify Sales Team (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [360, 60]
    },
    {
      "parameters": { "sendTo": "={{ $json.body.call.customer.number }}@example-followup.com", "subject": "Thanks for calling", "message": "Following up on your call — let us know if you have any questions." },
      "id": "vapi-followup-01",
      "name": "Send Follow-up (Non-Qualified)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [360, 180]
    }
  ],
  "connections": {
    "Vapi Call Webhook": { "main": [[{ "node": "Route Event Type", "type": "main", "index": 0 }]] },
    "Route Event Type": {
      "main": [
        [{ "node": "Extract Booking Params", "type": "main", "index": 0 }],
        [{ "node": "Log Call to Google Sheet", "type": "main", "index": 0 }]
      ]
    },
    "Extract Booking Params": { "main": [[{ "node": "Check Calendar Availability", "type": "main", "index": 0 }]] },
    "Check Calendar Availability": { "main": [[{ "node": "If Slot Free", "type": "main", "index": 0 }]] },
    "If Slot Free": {
      "main": [
        [{ "node": "Create Calendar Event", "type": "main", "index": 0 }],
        [{ "node": "Respond: Slot Taken", "type": "main", "index": 0 }]
      ]
    },
    "Create Calendar Event": { "main": [[{ "node": "Respond: Slot Booked", "type": "main", "index": 0 }]] },
    "Log Call to Google Sheet": { "main": [[{ "node": "If Qualified Lead", "type": "main", "index": 0 }]] },
    "If Qualified Lead": {
      "main": [
        [{ "node": "Notify Sales Team (Slack)", "type": "main", "index": 0 }],
        [{ "node": "Send Follow-up (Non-Qualified)", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": true }
}
