      "id": "gm-getmsg-01",
      "name": "Get Unread Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "from", "value": "={{ $json.headers.from }}" },
            { "name": "subject", "value": "={{ $json.headers.subject }}" },
            { "name": "body", "value": "={{ $json.text }}" }
          ]
        }
      },
      "id": "gm-fields-01",
      "name": "Get Required Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You triage inbound business emails. Decide whether you have enough information to draft a helpful reply. If yes, write a professional draft reply. If not, set can_respond to false."
        }
      },
      "id": "gm-agent-01",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [140, 0]
    },
