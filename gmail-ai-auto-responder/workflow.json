    {
      "parameters": { "operation": "reply", "messageId": "={{ $('Get Unread Email').item.json.id }}", "message": "={{ $json.output.draft_reply }}" },
      "id": "gm-draft-01",
      "name": "Create a draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [580, -60]
    },
    {
      "parameters": { "operation": "addLabels", "messageId": "={{ $('Get Unread Email').item.json.id }}", "labelIds": ["Action"] },
      "id": "gm-label-01",
      "name": "Label Email As \"Action\"",
      "type": "n8n-nodes-base.gmail",
