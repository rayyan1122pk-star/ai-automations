    { "parameters": {}, "id": "gm-mem-01", "name": "Memory", "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow", "typeVersion": 1.3, "position": [180, 180] },
    {
      "parameters": { "schemaType": "manual", "inputSchema": "{\"type\":\"object\",\"properties\":{\"can_respond\":{\"type\":\"boolean\"},\"draft_reply\":{\"type\":\"string\"}}}" },
      "id": "gm-parser-01",
      "name": "Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [260, 180]
    },
